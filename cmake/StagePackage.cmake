cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED SOURCE_PACKAGE OR NOT DEFINED DEST_PACKAGE)
  message(FATAL_ERROR "SOURCE_PACKAGE and DEST_PACKAGE are required")
endif()

if(NOT DEFINED BOT_PROFILE)
  set(BOT_PROFILE kilobyte)
endif()
if(NOT BOT_PROFILE MATCHES "^(kilobyte|megabyte)$")
  message(FATAL_ERROR "BOT_PROFILE must be kilobyte or megabyte")
endif()
get_filename_component(source "${SOURCE_PACKAGE}" REALPATH)
get_filename_component(destination "${DEST_PACKAGE}" ABSOLUTE)
# Bob split retains platform directories and root files, not shared directories.
# Keep bot.toml at the shared root while placing nested assets with each launcher.
set(asset_destinations "${destination}")
if(DEFINED PACKAGE_PLATFORMS)
  if(NOT PACKAGE_PLATFORMS)
    message(FATAL_ERROR "PACKAGE_PLATFORMS must name at least one built platform")
  endif()
  set(asset_destinations)
  foreach(platform IN LISTS PACKAGE_PLATFORMS)
    if(NOT platform MATCHES "^(x86_64-pc-windows-msvc|x86_64-unknown-linux-gnu)$" OR
       NOT IS_DIRECTORY "${destination}/${platform}")
      message(FATAL_ERROR "Missing or unsupported package platform: ${platform}")
    endif()
    list(APPEND asset_destinations "${destination}/${platform}")
  endforeach()
endif()
foreach(filename POLICY.lt SHARED_HEAD.lt)
  set(model "${source}/${BOT_PROFILE}/${filename}")
  if(NOT EXISTS "${model}" OR IS_DIRECTORY "${model}")
    message(FATAL_ERROR "Missing model: ${model}")
  endif()
  file(SIZE "${model}" model_size)
  if(model_size EQUAL 0)
    message(FATAL_ERROR "Empty model: ${model}")
  endif()
  foreach(asset_destination IN LISTS asset_destinations)
    if(NOT "${model}" STREQUAL "${asset_destination}/${filename}")
      configure_file("${model}" "${asset_destination}/${filename}" COPYONLY)
    endif()
  endforeach()
endforeach()
if(NOT source STREQUAL destination)
  foreach(asset loadout.toml logo.png device.txt)
    if(EXISTS "${source}/${asset}")
      configure_file("${source}/${asset}" "${destination}/${asset}" COPYONLY)
    endif()
  endforeach()
  # Never ship the developer's currently selected rank or persisted match roster.
  if(BOT_PROFILE STREQUAL "kilobyte")
    set(default_name "Kilobyte[Champ I]")
  else()
    set(default_name "Megabyte")
  endif()
  file(READ "${source}/${BOT_PROFILE}/bot.toml" config)
  string(REGEX REPLACE "(^|\n)name = \"[^\"]*\"" "\\1name = \"${default_name}\"" config "${config}")
  file(WRITE "${destination}/bot.toml" "${config}")
endif()

get_filename_component(repository "${source}" DIRECTORY)
file(READ "${repository}/README.md" readme)
string(REPLACE "src=\"rlbot/logo.png\"" "src=\"logo.png\"" readme "${readme}")
file(WRITE "${destination}/README.md" "${readme}")
