cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED SOURCE_PACKAGE OR NOT DEFINED DEST_PACKAGE)
  message(FATAL_ERROR "SOURCE_PACKAGE and DEST_PACKAGE are required")
endif()

get_filename_component(source "${SOURCE_PACKAGE}" REALPATH)
get_filename_component(destination "${DEST_PACKAGE}" ABSOLUTE)
file(READ "${source}/models/manifest.json" manifest)
string(JSON model_count LENGTH "${manifest}" models)
if(NOT model_count EQUAL 3)
  message(FATAL_ERROR "The manifest must contain exactly three model pairs")
endif()
set(seen_paths)
math(EXPR last_model "${model_count} - 1")
foreach(model RANGE 0 ${last_model})
  string(JSON file_count LENGTH "${manifest}" models ${model} files)
  if(NOT file_count EQUAL 2)
    message(FATAL_ERROR "Each model must contain exactly two files")
  endif()
  math(EXPR last_file "${file_count} - 1")
  foreach(index RANGE 0 ${last_file})
    string(JSON relative GET "${manifest}" models ${model} files ${index} path)
    string(JSON expected GET "${manifest}" models ${model} files ${index} sha256)
    if(NOT relative MATCHES "^models/(byte|kilobyte|megabyte)/(POLICY|SHARED_HEAD)\\.lt$")
      message(FATAL_ERROR "Unexpected model path: ${relative}")
    endif()
    if(relative IN_LIST seen_paths)
      message(FATAL_ERROR "Duplicate model path: ${relative}")
    endif()
    list(APPEND seen_paths "${relative}")
    string(JSON expected_size GET "${manifest}" models ${model} files ${index} bytes)
    file(SIZE "${source}/${relative}" actual_size)
    if(NOT actual_size EQUAL expected_size)
      message(FATAL_ERROR "Model size mismatch: ${relative}")
    endif()
    file(SHA256 "${source}/${relative}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Model checksum mismatch: ${relative}")
    endif()
    if(NOT source STREQUAL destination)
      get_filename_component(folder "${destination}/${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${folder}")
      configure_file("${source}/${relative}" "${destination}/${relative}" COPYONLY)
    endif()
  endforeach()
endforeach()
if(NOT source STREQUAL destination)
  foreach(asset models/manifest.json loadout.toml logo.png device.txt)
    if(EXISTS "${source}/${asset}")
      configure_file("${source}/${asset}" "${destination}/${asset}" COPYONLY)
    endif()
  endforeach()
  # Never ship the developer's currently selected rank or persisted match roster.
  file(READ "${source}/bot.toml" config)
  string(REGEX REPLACE "(^|\n)name = \"[^\"]*\"" "\\1name = \"Megabyte\"" config "${config}")
  file(WRITE "${destination}/bot.toml" "${config}")
endif()

# Keep the license and attribution with every distributable, including flat local builds.
get_filename_component(repository "${source}" DIRECTORY)
foreach(document LICENSE)
  configure_file("${repository}/${document}" "${destination}/${document}" COPYONLY)
endforeach()
# Internal reports and calibration notices are deliberately not distributed.
foreach(document
    cpp-interface/LICENSE inc/RocketSim/LICENSE
    inc/RocketSim/libsrc/bullet3-3.24/LICENSE.txt)
  configure_file("${repository}/${document}" "${destination}/${document}" COPYONLY)
endforeach()
file(READ "${repository}/README.md" readme)
string(REPLACE "src=\"rlbot/logo.png\"" "src=\"logo.png\"" readme "${readme}")
string(REPLACE "](rlbot/models/manifest.json)" "](models/manifest.json)" readme "${readme}")
file(WRITE "${destination}/README.md" "${readme}")
